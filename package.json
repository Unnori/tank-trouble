{
  "name": "tank-trouble-coopanion",
  "version": "0.7.0",
  "description": "坦克回廊的 Coopanion 二创：对局里的关键节点会送给桌宠 Coo，由它开口说话",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "arena": "node scripts/arena.mjs",
    "dist": "electron-builder --win"
  },
  "author": "Whalen (AbyssWhalen) — 上游原作；本仓库二创见 README",
  "contributors": [
    "Unnori"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unnori/tank-trouble.git"
  },
  "homepage": "https://github.com/Unnori/tank-trouble#readme",
  "bugs": {
    "url": "https://github.com/Unnori/tank-trouble/issues"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.unnori.tankcorridor",
    "productName": "TankCorridor",
    "directories": {
      "output": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "index.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "坦克回廊"
    }
  }
}